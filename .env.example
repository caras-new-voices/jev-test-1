# Vercel AI Gateway key, used by api/evaluate.ts to call Jev (typesafe-ai/jev).
# Get one from the Vercel dashboard (AI Gateway → API keys); it looks like "vck_...".
#
# Set the real value in Vercel → Project → Settings → Environment Variables,
# NOT in this file and never in a commit. For local work run `vercel env pull`,
# which writes .env.local (git-ignored).
AI_GATEWAY_API_KEY=
